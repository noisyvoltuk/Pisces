<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pisces.Core\Pisces.Core.csproj" />
    <ProjectReference Include="..\Pisces.Infrastructure\Pisces.Infrastructure.csproj" />
    <ProjectReference Include="..\Pisces.CSound\Pisces.CSound.csproj" />
    <!-- Virtual hardware for development; registered only when Pisces:UseSimulator is true. -->
    <ProjectReference Include="..\Pisces.Simulator\Pisces.Simulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.12" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\module_map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
