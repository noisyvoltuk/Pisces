{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pisces": {
    "CsoundPath": "/usr/bin/csound",
    "PatchesDirectory": "/home/pi/Pisces/csound/patches",
    "UdoDirectory": "/home/pi/Pisces/csound/udos",
    "DataDirectory": "/home/pi/Pisces/data",
    "UseSimulator": false
  },
  "Csound": {
    "OscHost": "127.0.0.1",
    "OscSendPort": 7770,
    "OscListenPort": 7771,
    "PingIntervalSeconds": 2.0,
    "MissedPongLimit": 3,
    "LogUnit": "pisces-csound"
  },
  "Hardware": {
    "SelectorEncoder": {
      "Id": "sel",
      "GpioClk": 17,
      "GpioDt": 18,
      "GpioSw": 27
    },
    "ParameterEncoders": [
      { "Id": "enc1", "Slot": "param1", "GpioClk": 5,  "GpioDt": 6,  "GpioSw": 13, "DisplayIndex": 0, "DisplayRow": 0 },
      { "Id": "enc2", "Slot": "param2", "GpioClk": 19, "GpioDt": 26, "GpioSw": 21, "DisplayIndex": 0, "DisplayRow": 1 },
      { "Id": "enc3", "Slot": "param3", "GpioClk": 20, "GpioDt": 16, "GpioSw": 12, "DisplayIndex": 1, "DisplayRow": 0 },
      { "Id": "enc4", "Slot": "param4", "GpioClk": 7,  "GpioDt": 1,  "GpioSw": 0,  "DisplayIndex": 1, "DisplayRow": 1 }
    ],
    "Toggles": [
      { "Id": "tog1", "Label": "Filter bypass", "Channel": "vcf_bypass", "GpioPin": 14, "DisplayIndex": 3, "DisplayRow": 0 }
    ],
    "Buttons": [
      { "Id": "patch_up",   "Action": "patch_next", "GpioPin": 9  },
      { "Id": "patch_down", "Action": "patch_prev", "GpioPin": 11 }
    ],
    "OledDisplays": [
      { "Index": 0, "MultiplexerChannel": 0, "I2cAddress": 60, "Role": "params_1_2" },
      { "Index": 1, "MultiplexerChannel": 1, "I2cAddress": 60, "Role": "params_3_4" },
      { "Index": 2, "MultiplexerChannel": 2, "I2cAddress": 60, "Role": "spare" },
      { "Index": 3, "MultiplexerChannel": 3, "I2cAddress": 60, "Role": "toggles" }
    ],
    "TftDisplay": {
      "SpiChannel": 0,
      "GpioDc": 25,
      "GpioRst": 24,
      "Width": 320,
      "Height": 240
    },
    "I2c": {
      "BusId": 1,
      "MultiplexerAddress": 112
    }
  }
}
