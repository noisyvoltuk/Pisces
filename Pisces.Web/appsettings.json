{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
    }
  },
  "Pisces": {
    "CsoundPath": "/usr/bin/csound",
    "PatchesDirectory": "csound/patches",
    "UdoDirectory": "csound/udos",
    "DataDirectory": "data",
    "UseSimulator": true,
    "UseSimulatedCsound": false,
    "UseHardwareControls": true,
    "UseHardwareDisplays": true
  },
  "Csound": {
    "OscHost": "127.0.0.1",
    "OscSendPort": 7770,
    "OscListenPort": 7771,
    "PingIntervalSeconds": 2.0,
    "MissedPongLimit": 3,
    "LogUnit": "pisces-csound"
  },
  "Hardware": {
    "SelectorEncoder": {
      "Id": "sel",
      "GpioClk": 17,
      "GpioDt": 18,
      "GpioSw": 27
    },
    "ParameterEncoders": [
      { "Id": "enc1", "Slot": "param1", "GpioClk": 5,  "GpioDt": 6,  "GpioSw": 13, "DisplayIndex": 0, "DisplayRow": 0 },
      { "Id": "enc2", "Slot": "param2", "GpioClk": 19, "GpioDt": 26, "GpioSw": 21, "DisplayIndex": 1, "DisplayRow": 0 },
      { "Id": "enc3", "Slot": "param3", "GpioClk": 20, "GpioDt": 16, "GpioSw": 12, "DisplayIndex": 2, "DisplayRow": 0 },
      { "Id": "enc4", "Slot": "param4", "GpioClk": 7,  "GpioDt": 1,  "GpioSw": 0,  "DisplayIndex": 3, "DisplayRow": 0 }
    ],
    "Toggles": [],
    "Buttons": [
      { "Id": "save_patch", "Action": "save_patch",  "GpioPin": 14 },
      { "Id": "load_patch", "Action": "load_patch",  "GpioPin": 23 }
    ],
    "OledDisplays": [
      { "Index": 0, "MultiplexerChannel": 0, "I2cAddress": 60, "Role": "params_1" },
      { "Index": 1, "MultiplexerChannel": 2, "I2cAddress": 60, "Role": "params_2" },
      { "Index": 2, "MultiplexerChannel": 1, "I2cAddress": 60, "Role": "params_3" },
      { "Index": 3, "MultiplexerChannel": 3, "I2cAddress": 60, "Role": "params_4" }
    ],
    "TftDisplay": {
      "SpiChannel": 0,
      "GpioDc": 25,
      "GpioRst": 24,
      "Width": 320,
      "Height": 240,
      "Rotate180": true
    },
    "I2c": {
      "BusId": 1,
      "MultiplexerAddress": 112
    }
  }
}
