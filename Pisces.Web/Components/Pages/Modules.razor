@page "/modules"
@rendermode InteractiveServer
@implements IDisposable

@using Pisces.Infrastructure.Services
@inject IModuleMap ModuleMap
@inject PatchService Patches
@inject ISynthStateService State

<PageTitle>Modules</PageTitle>

<h1>Module map</h1>
<p class="text-muted">
    Each module fills a <em>role</em>; one is active per role at a time. Changes are written to
    <code>module_map.json</code> in the running app's data directory.
</p>

<div class="row">
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Modules (@_modules.Count)</span>
                <button class="btn btn-sm btn-primary" @onclick="NewModule">New</button>
            </div>
            <div class="card-body p-0">
                @foreach (var role in _roles)
                {
                    <div class="px-3 pt-2 pb-1 bg-body-secondary small fw-bold">@role</div>
                    @foreach (var m in _modules.Where(m => RoleOf(m) == role))
                    {
                        var module = m;
                        var isActive = State.Current.ActiveModules.GetValueOrDefault(role) == module.Id;
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <div>
                                <strong>@module.Name</strong>
                                @if (isActive) { <span class="badge bg-primary ms-1">active</span> }
                                <div class="text-muted small">@module.Id · @module.Type · @module.Parameters.Count params</div>
                            </div>
                            <div class="text-nowrap">
                                @if (!isActive)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => MakeActive(role, module.Id)">Activate</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(module)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(module.Id)">✕</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (_editing is not null)
        {
            <div class="card mb-3">
                <div class="card-header">@(_isNew ? "New module" : $"Edit — {_editing.Name}")</div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label mb-0 small">Id</label>
                            <input class="form-control form-control-sm" @bind="_editing.Id" readonly="@(!_isNew)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label mb-0 small">Name</label>
                            <input class="form-control form-control-sm" @bind="_editing.Name" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Role</label>
                            <input class="form-control form-control-sm" @bind="_editing.Role" />
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">Type</label>
                            <select class="form-select form-select-sm" @bind="_editing.Type">
                                @foreach (var t in Enum.GetValues<ModuleType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label mb-0 small">UDO file</label>
                            <input class="form-control form-control-sm" @bind="_editing.UdoFile" placeholder="(blank = built-in)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-0 small">Description</label>
                            <input class="form-control form-control-sm" @bind="_editing.Description" />
                        </div>
                    </div>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Slot</th><th>Channel</th><th>Label</th>
                                <th>Min</th><th>Max</th><th>Default</th><th>Unit</th><th>Log</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var slotName in SlotNames)
                        {
                            var ps = _editing.Parameters[slotName];
                            <tr>
                                <td class="small text-muted">@slotName</td>
                                <td><input class="form-control form-control-sm" @bind="ps.Channel" /></td>
                                <td><input class="form-control form-control-sm" @bind="ps.Label" /></td>
                                <td style="width:5rem"><input class="form-control form-control-sm" type="number" step="any" @bind="ps.Min" /></td>
                                <td style="width:5rem"><input class="form-control form-control-sm" type="number" step="any" @bind="ps.Max" /></td>
                                <td style="width:5rem"><input class="form-control form-control-sm" type="number" step="any" @bind="ps.Default" /></td>
                                <td style="width:4rem"><input class="form-control form-control-sm" @bind="ps.Unit" /></td>
                                <td class="text-center"><input class="form-check-input" type="checkbox" @bind="ps.Logarithmic" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p class="text-muted small">Rows with an empty channel are dropped on save.</p>

                    <button class="btn btn-primary btn-sm" disabled="@(!CanSave)" @onclick="Save">Save</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _editing = null">Cancel</button>
                    @if (_error is not null) { <span class="text-danger small ms-2">@_error</span> }
                </div>
            </div>
        }
        else
        {
            <p class="text-muted">Select a module to edit, or add a new one.</p>
        }
    </div>
</div>

@code {
    private static readonly string[] SlotNames = ["param1", "param2", "param3", "param4"];

    private List<Module> _modules = new();
    private List<string> _roles = new();
    private Module? _editing;
    private bool _isNew;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        State.StateChanged += OnStateChanged;
    }

    private void OnStateChanged(object? sender, SynthState state) => InvokeAsync(StateHasChanged);

    private async Task Reload()
    {
        _modules = (await ModuleMap.GetAllModulesAsync()).ToList();
        _roles = _modules.Select(RoleOf).Distinct().ToList();
    }

    private static string RoleOf(Module m) =>
        string.IsNullOrWhiteSpace(m.Role) ? m.Type.ToString().ToLowerInvariant() : m.Role;

    private bool CanSave => _editing is not null
                            && !string.IsNullOrWhiteSpace(_editing.Id)
                            && !string.IsNullOrWhiteSpace(_editing.Name)
                            && !string.IsNullOrWhiteSpace(_editing.Role);

    private void NewModule()
    {
        _editing = new Module { Type = ModuleType.Vco };
        EnsureSlots(_editing);
        _isNew = true;
        _error = null;
    }

    private void Edit(Module module)
    {
        // work on a clone so Cancel discards
        _editing = new Module
        {
            Id = module.Id,
            Name = module.Name,
            Role = RoleOf(module),
            Type = module.Type,
            UdoFile = module.UdoFile,
            Description = module.Description,
            Parameters = module.Parameters.ToDictionary(
                p => p.Key,
                p => new ParameterSlot
                {
                    Channel = p.Value.Channel, Label = p.Value.Label,
                    Min = p.Value.Min, Max = p.Value.Max, Default = p.Value.Default,
                    Unit = p.Value.Unit, Logarithmic = p.Value.Logarithmic
                })
        };
        EnsureSlots(_editing);
        _isNew = false;
        _error = null;
    }

    private static void EnsureSlots(Module m)
    {
        foreach (var name in SlotNames)
            if (!m.Parameters.ContainsKey(name))
                m.Parameters[name] = new ParameterSlot();
    }

    private async Task Save()
    {
        if (_editing is null)
            return;

        var toSave = new Module
        {
            Id = _editing.Id.Trim(),
            Name = _editing.Name.Trim(),
            Role = _editing.Role.Trim(),
            Type = _editing.Type,
            UdoFile = _editing.UdoFile.Trim(),
            Description = _editing.Description.Trim(),
            Parameters = SlotNames
                .Where(s => !string.IsNullOrWhiteSpace(_editing.Parameters[s].Channel))
                .ToDictionary(s => s, s => _editing.Parameters[s])
        };

        try
        {
            await ModuleMap.SaveModuleAsync(toSave);
            _editing = null;
            await Reload();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Delete(string id)
    {
        await ModuleMap.DeleteModuleAsync(id);
        if (_editing?.Id == id)
            _editing = null;
        await Reload();
    }

    private async Task MakeActive(string role, string moduleId)
    {
        await Patches.ActivateModuleAsync(role, moduleId);
    }

    public void Dispose() => State.StateChanged -= OnStateChanged;
}
