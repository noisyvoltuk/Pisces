@implements IDisposable
@using Pisces.Simulator
@inject ICsoundEngine Engine

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>CSound engine — @EngineKind</span>
        <span class="badge @(Engine.IsRunning ? "bg-success" : "bg-secondary")">
            @(Engine.IsRunning ? "online" : "offline")
        </span>
    </div>
    <div class="card-body p-0">
        <pre class="mb-0 p-2" style="max-height: @(MaxHeight)px; overflow-y: auto; font-size: 0.8rem;">@string.Join("\n", _log)</pre>
    </div>
</div>

@code {
    [Parameter] public int MaxHeight { get; set; } = 260;

    private IReadOnlyList<string> _log = Array.Empty<string>();

    private string EngineKind => Engine is SimulatedCsoundEngine ? "simulated (no audio)" : "OSC";

    protected override void OnInitialized()
    {
        _log = Engine.RecentLog();
        Engine.LogReceived += OnLog;
    }

    private void OnLog(object? sender, string line)
    {
        _log = Engine.RecentLog();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Engine.LogReceived -= OnLog;
}
